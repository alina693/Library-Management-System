# Copy this file to ".env" for local development.
# Get DATABASE_URL from your Neon dashboard: Project -> Connection Details -> Connection string.
# It looks like: postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/library_db?sslmode=require
PORT=3000

# When deploying on Render, you won't upload this .env file —
# instead you paste these same values into Render's "Environment" tab.
